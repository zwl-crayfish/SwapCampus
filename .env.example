# SwapCampus 环境变量配置 (复制为 .env 使用)
# 本地开发: 保持默认即可
# 生产环境: 务必修改所有密钥

# MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/swapcampus?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Redis
SPRING_DATA_REDIS_HOST=localhost

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=swapcampus

# JWT (生产环境务必修改!)
JWT_SECRET=ChangeThisToARandomLongStringInProduction
