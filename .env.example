# ============================================
# SwapCampus 环境变量配置
# 复制为 .env 后按需修改
#
# 本地开发: 保持默认即可
# 生产环境: 务必修改所有密码和密钥！
# ============================================

# ---- Docker 镜像 ----
DOCKER_REGISTRY=swapcampus
IMAGE_TAG=latest

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=swapcampus
MYSQL_PORT=3306
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/swapcampus?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# ---- Redis ----
REDIS_PORT=6379
SPRING_DATA_REDIS_HOST=redis

# ---- MinIO ----
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT_DOCKER=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=swapcampus

# ---- 应用端口 ----
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ---- JWT (生产环境务必修改!) ----
JWT_SECRET=ChangeThisToARandomLongStringInProduction
