apiVersion: v1
kind: Secret
metadata:
  name: swapcampus-secret
  namespace: swapcampus
type: Opaque
stringData:
  # ⚠️ 生产环境: 请使用 Sealed Secrets 或 External Secrets Operator 管理
  # 不要将明文密钥提交到 Git！
  MYSQL_ROOT_PASSWORD: "root"
  SPRING_DATASOURCE_USERNAME: "root"
  SPRING_DATASOURCE_PASSWORD: "root"
  MINIO_ACCESS_KEY: "minioadmin"
  MINIO_SECRET_KEY: "minioadmin"
  JWT_SECRET: "ChangeThisToARandomLongStringInProduction"
